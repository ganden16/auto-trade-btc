# ==============================================================================
# MODE TRADING: true = DEMO (Binance Testnet), false = REAL (Binance Live)
# ==============================================================================
BINANCE_TESTNET=true

# Kredensial Akun DEMO (Binance Futures Testnet: https://testnet.binancefuture.com)
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_binance_testnet_api_secret

# Kredensial Akun ASLI / REAL (Binance Futures Live: https://fapi.binance.com)
BINANCE_REAL_API_KEY=your_binance_real_api_key
BINANCE_REAL_API_SECRET=your_binance_real_api_secret

# Fallback (kompatibilitas mundur jika hanya menggunakan 1 pasang key)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kredensial AI Gatekeeper SumoPod (https://sumopod.com)
SUMOPOD_API_KEY=your_sumopod_api_key
AI_MODEL_NAME=glm-5.3-flash

# Konfigurasi Cache & Web Server
REDIS_HOST=redis
REDIS_PORT=6379
PORT=28080
LOG_LEVEL=info

# Keamanan Dasbor (Password untuk Konfirmasi Beralih Mode & Panic/Unlock Halt)
DASHBOARD_PASSWORD=your_secure_password

# Notifikasi Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kredensial Deploy VPS (Opsional - Diperlukan jika menggunakan profil deploy-vps)
VPS_IP=
VPS_USER=ubuntu
VPS_PASS=
